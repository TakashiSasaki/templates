{
  "$schema": "https://templates.moukaeritai.work/schemas/agent-bootstrap.schema.json",
  "schema_version": 2,
  "repository": "TakashiSasaki/templates",
  "canonical_url": "https://templates.moukaeritai.work/agent.json",
  "purpose": "Compose new or existing software repositories",
  "composition": {
    "publication_revision": "6b20d0364aeb32501d4e490fc871e843e268e48b",
    "installer": {
      "repository": "TakashiSasaki/templates",
      "revision": "677dc68fe35fc285638b46685950d31e3a3d3c2f",
      "path": "scripts/install_composition_skill.py",
      "sha256": "134fae0e01d1ee1d560f5f2c0284dc56e241626fd4d89a426a68fa41d7e93e34",
      "url": "https://raw.githubusercontent.com/TakashiSasaki/templates/677dc68fe35fc285638b46685950d31e3a3d3c2f/scripts/install_composition_skill.py"
    },
    "skill": {
      "name": "composition",
      "repository": "TakashiSasaki/templates",
      "revision": "69af2ed811875f95838bf978ee09365554405664",
      "path": "skills/composition",
      "entrypoint": "scripts/run.py",
      "instructions_url": "https://raw.githubusercontent.com/TakashiSasaki/templates/69af2ed811875f95838bf978ee09365554405664/skills/composition/SKILL.md"
    },
    "toolchain": {
      "repository": "TakashiSasaki/templates",
      "revision": "16d3eb411729a79549dbaaf6dab1d05207f83415"
    }
  },
  "requirements": {
    "python": {
      "minimum": "3.11",
      "maximum": "3.14"
    },
    "https": true
  },
  "bootstrap": {
    "download": "https",
    "verify": "sha256-before-execute",
    "execute": "python-isolated",
    "installation_modes": [
      "persistent",
      "transient"
    ],
    "canonical_operation": "execute-verified-installer-argv",
    "reimplementation_policy": "do-not-reimplement",
    "verified_installer_argv": [
      "{python}",
      "-I",
      "-c",
      "import hashlib\nimport pathlib\nimport subprocess\nimport sys\nimport urllib.request\n\nurl, expected, installer_file, skill_target = sys.argv[1:5]\ndata = urllib.request.urlopen(url, timeout=30).read()\nactual = hashlib.sha256(data).hexdigest()\nif actual != expected:\n    raise SystemExit(\n        f\"installer SHA-256 mismatch: expected {expected}, got {actual}\"\n    )\npath = pathlib.Path(installer_file)\npath.parent.mkdir(parents=True, exist_ok=True)\npath.write_bytes(data)\nsubprocess.run(\n    [sys.executable, \"-I\", str(path), skill_target],\n    check=True,\n)\n",
      "{installer_url}",
      "{installer_sha256}",
      "{installer_file}",
      "{skill_target}"
    ],
    "argument_bindings": {
      "{installer_url}": "composition.installer.url",
      "{installer_sha256}": "composition.installer.sha256"
    },
    "caller_inputs": [
      "{python}",
      "{installer_file}",
      "{skill_target}"
    ]
  },
  "workflow": {
    "runner_argv": [
      "{python}",
      "{skill_target}/scripts/run.py",
      "--repository",
      "{repository}",
      "{command}"
    ],
    "diagnose": "doctor",
    "provenance": "provenance",
    "inspect_before_mutation": "inspect",
    "plan_before_apply": true,
    "validate_after_apply": true
  }
}
