{
  "schema_version": 1,
  "provider": "policy",
  "protocol": "publication-bundle",
  "exports": [
    {"kind": "document", "namespace": "policy.documentation", "media_type": "text/markdown", "identity_basis": "catalog-document-id", "feature": "publication.generic-document.v1", "rights": "allowlisted"},
    {"kind": "asset", "namespace": "policy.assets", "media_type": "application/octet-stream", "identity_basis": "destination-and-sha256", "feature": "publication.static-asset.v1", "rights": "allowlisted"}
  ],
  "requirements": [
    {"feature": "publication.generic-document.v1", "required": true, "fallback": "generic-document"},
    {"feature": "publication.static-asset.v1", "required": true, "fallback": "none"}
  ]
}
