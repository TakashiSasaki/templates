{
  "$schema": "../schemas/viewports.schema.json",
  "schemaVersion": 1,
  "viewports": [
    {
      "id": "compact",
      "minWidthPx": 0,
      "maxWidthPx": 767,
      "interactionModes": ["touch", "keyboard"],
      "description": "Narrow layouts where content prioritization and reflow are required."
    },
    {
      "id": "regular",
      "minWidthPx": 768,
      "maxWidthPx": 1279,
      "interactionModes": ["touch", "pointer", "keyboard"],
      "description": "Intermediate layouts suitable for tablets and constrained desktop windows."
    },
    {
      "id": "wide",
      "minWidthPx": 1280,
      "interactionModes": ["pointer", "keyboard"],
      "description": "Wide layouts that may expose additional context without making it mandatory."
    }
  ],
  "constraints": {
    "zoomSupported": true,
    "horizontalScrolling": "content-specific",
    "orientationIndependent": true
  }
}
