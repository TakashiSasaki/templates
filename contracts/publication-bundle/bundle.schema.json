{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:templates:publication-bundle:3",
  "title": "Integrated Publication Bundle v3 identity manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "providers",
    "configuration_digest",
    "files",
    "content_digest",
    "identity"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "revision"
      ],
      "properties": {
        "authority": {
          "enum": [
            "site-internal-integration",
            "integration"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition",
        "policy"
      ],
      "properties": {
        "composition": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "policy": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "object",
      "minProperties": 9,
      "patternProperties": {
        "^(documents|navigation|translation-availability|translation-publication|reader-navigation-runtime|glossary|guided-navigation|guided-locales|provenance)\\.json$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "sha256"
          ],
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "^publication/.+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "sha256"
          ],
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$comment": "publication_bundle.contract additionally enforces safe physical paths, exact bounded inventory, structural model/publication closure, content and identity hashes, translations, glossary, graph and provenance."
}
