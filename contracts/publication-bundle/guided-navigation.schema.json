{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:templates:publication-bundle:guided-navigation:2",
  "title": "Integrated provider progressive-discovery graph v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "revision",
          "root_index",
          "indexes",
          "edges",
          "diagnostics"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "root_index": {
            "const": "index.md"
          },
          "indexes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/index"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/edge"
            }
          },
          "diagnostics": {
            "$ref": "#/$defs/diagnostics"
          }
        }
      }
    }
  },
  "$comment": "Structural precheck only. Acceptance MUST also validate the raw JSON with publication_bundle.graph.load_graph and validate_provider_graph, or use publication_bundle.contract.validate for a complete Bundle. JSON Schema numeric equality accepts 2.0 and 2e0 as integer values; the canonical runtime requires integer JSON tokens for version, depth, levels, lines and diagnostics. Schema-only validation is insufficient.",
  "$defs": {
    "section": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "level"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "level": {
              "type": "integer",
              "minimum": 2,
              "maximum": 6
            }
          }
        }
      ]
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "title",
        "sections",
        "depth",
        "object_id"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:[^/]+/)*index\\.md$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "object_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "kind",
        "label",
        "description",
        "raw_target",
        "target",
        "line"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "index",
            "file",
            "directory",
            "fragment",
            "external"
          ]
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "raw_target": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "fragment": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "required": [
        "index_count",
        "edge_count",
        "max_index_depth",
        "cycle_edges",
        "multiple_parent_indexes"
      ],
      "properties": {
        "index_count": {
          "type": "integer",
          "minimum": 0
        },
        "edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_index_depth": {
          "type": "integer",
          "minimum": 0
        },
        "cycle_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "multiple_parent_indexes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
