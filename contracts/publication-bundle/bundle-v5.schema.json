{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:templates:publication-bundle:5",
  "title": "Integrated Publication Bundle 5 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "providers",
    "configuration_digest",
    "files",
    "content_digest",
    "identity"
  ],
  "properties": {
    "schema_version": {
      "const": 5
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "revision"
      ],
      "properties": {
        "authority": {
          "enum": [
            "integration",
            "site-internal-integration"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$",
        "not": {
          "enum": [
            "site",
            "integration"
          ]
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      }
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "object",
      "minProperties": 7,
      "patternProperties": {
        "^publication/.+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "sha256"
          ],
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "^(documents|translation-availability|translation-publication|glossary|guided-navigation|guided-locales|provenance)\\.json$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "sha256"
          ],
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "documents.json",
        "translation-availability.json",
        "translation-publication.json",
        "glossary.json",
        "guided-navigation.json",
        "guided-locales.json",
        "provenance.json"
      ]
    }
  }
}
