{
  "$schema": "../schemas/routes.schema.json",
  "schemaVersion": 1,
  "routes": [
    {
      "id": "home",
      "path": "/",
      "surface": "public",
      "canonical": true,
      "aliases": [],
      "authentication": "optional",
      "deepLink": true,
      "historyBehavior": "push",
      "authenticationReturn": "same-route",
      "states": ["loading", "populated", "recoverable-error", "offline"],
      "accessibility": {
        "documentTitleRequired": true,
        "focusTarget": "main-heading"
      }
    },
    {
      "id": "application-home",
      "path": "/app",
      "surface": "application",
      "canonical": true,
      "aliases": [],
      "authentication": "required",
      "deepLink": true,
      "historyBehavior": "push",
      "authenticationReturn": "same-route",
      "states": ["loading", "empty", "populated", "partial", "recoverable-error", "offline", "unauthorized", "forbidden"],
      "accessibility": {
        "documentTitleRequired": true,
        "focusTarget": "main-heading"
      }
    },
    {
      "id": "status",
      "path": "/status",
      "surface": "status",
      "canonical": true,
      "aliases": [],
      "authentication": "optional",
      "deepLink": true,
      "historyBehavior": "replace",
      "authenticationReturn": "not-applicable",
      "states": ["loading", "populated", "partial", "recoverable-error"],
      "accessibility": {
        "documentTitleRequired": true,
        "focusTarget": "main-heading"
      }
    }
  ]
}
