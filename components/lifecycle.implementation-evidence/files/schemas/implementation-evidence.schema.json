{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "mode",
    "requirements",
    "commands",
    "releaseGates",
    "records"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "requirementIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
    },
    "contractIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "nonBlankText": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "required",
        "verified"
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/requirementIdentifier"
        },
        "description": {
          "$ref": "#/$defs/nonBlankText"
        }
      }
    },
    "implementationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "description"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "description": {
          "$ref": "#/$defs/nonBlankText"
        },
        "locator": {
          "$ref": "#/$defs/nonBlankText"
        }
      }
    },
    "evidenceProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "kind": {
          "enum": [
            "unit-test",
            "integration-test",
            "end-to-end-test",
            "accessibility-test",
            "migration-test",
            "inspection",
            "other"
          ]
        },
        "description": {
          "$ref": "#/$defs/nonBlankText"
        },
        "locator": {
          "$ref": "#/$defs/nonBlankText"
        },
        "commandId": {
          "$ref": "#/$defs/identifier"
        },
        "expectedResult": {
          "$ref": "#/$defs/nonBlankText"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "purpose"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "command": {
          "$ref": "#/$defs/nonBlankText"
        },
        "purpose": {
          "$ref": "#/$defs/nonBlankText"
        }
      }
    },
    "releaseGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "commandIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "purpose": {
          "$ref": "#/$defs/nonBlankText"
        },
        "commandIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "contractItemTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contractId",
        "itemKind",
        "itemId"
      ],
      "properties": {
        "kind": {
          "const": "contract-item"
        },
        "contractId": {
          "$ref": "#/$defs/contractIdentifier"
        },
        "itemKind": {
          "$ref": "#/$defs/identifier"
        },
        "itemId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "transitionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contractId",
        "fromVersion",
        "toVersion"
      ],
      "properties": {
        "kind": {
          "const": "contract-transition"
        },
        "contractId": {
          "$ref": "#/$defs/contractIdentifier"
        },
        "fromVersion": {
          "type": "integer",
          "minimum": 1
        },
        "toVersion": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "target": {
      "oneOf": [
        {
          "$ref": "#/$defs/contractItemTarget"
        },
        {
          "$ref": "#/$defs/transitionTarget"
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "requirementIds",
        "implementationBoundary",
        "positiveEvidence",
        "negativeEvidence",
        "releaseGateIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "requirementIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirementIdentifier"
          }
        },
        "implementationBoundary": {
          "$ref": "#/$defs/implementationBoundary"
        },
        "positiveEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceProof"
          }
        },
        "negativeEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceProof"
          }
        },
        "releaseGateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "const": "../schemas/implementation-evidence.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "mode": {
      "enum": [
        "template",
        "product"
      ]
    },
    "requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "commands": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "releaseGates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/releaseGate"
      }
    },
    "records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "template"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "requirements": {
            "maxItems": 0
          },
          "commands": {
            "maxItems": 0
          },
          "releaseGates": {
            "maxItems": 0
          },
          "records": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "product"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "requirements": {
            "minItems": 1
          },
          "commands": {
            "minItems": 1
          },
          "releaseGates": {
            "minItems": 1
          },
          "records": {
            "items": {
              "properties": {
                "requirementIds": {
                  "minItems": 1
                },
                "implementationBoundary": {
                  "required": [
                    "locator"
                  ],
                  "properties": {
                    "status": {
                      "const": "verified"
                    }
                  }
                },
                "positiveEvidence": {
                  "items": {
                    "required": [
                      "kind",
                      "locator",
                      "commandId",
                      "expectedResult"
                    ],
                    "properties": {
                      "status": {
                        "const": "verified"
                      }
                    }
                  }
                },
                "negativeEvidence": {
                  "items": {
                    "required": [
                      "kind",
                      "locator",
                      "commandId",
                      "expectedResult"
                    ],
                    "properties": {
                      "status": {
                        "const": "verified"
                      }
                    }
                  }
                },
                "releaseGateIds": {
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    }
  ]
}
