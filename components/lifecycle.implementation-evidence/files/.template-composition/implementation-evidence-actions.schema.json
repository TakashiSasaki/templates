{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implementation-evidence executable action registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "actions"],
  "properties": {
    "$schema": {"const": "./implementation-evidence-actions.schema.json"},
    "schemaVersion": {"const": 1},
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check-release-readiness"],
      "properties": {
        "check-release-readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argv", "caller_inputs", "output_schema"],
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "caller_inputs": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^\\{[a-z_]+\\}$"}
            },
            "output_schema": {
              "const": ".template-composition/implementation-evidence-release-readiness.schema.json"
            }
          }
        }
      }
    }
  }
}
