{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Composition validation lifecycle projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lifecycle_stage", "implementation_evidence_mode", "release_readiness", "blocking_conditions", "deferred_checks", "deferred_proofs", "next_actions"],
  "properties": {
    "schema_version": {"const": 3},
    "lifecycle_stage": {"enum": ["composition-invalid", "scaffold-valid", "implemented-product", "release-ready"]},
    "implementation_evidence_mode": {"enum": ["missing", "invalid", "template", "planning", "product"]},
    "release_readiness": {"enum": ["not-evaluated", "not-ready", "ready"]},
    "blocking_conditions": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["composition-validation-failed", "implementation-evidence-missing", "implementation-evidence-invalid", "implementation-evidence-template", "implementation-evidence-planning", "checkpoint-state-invalid", "checkpoint-command-registry-invalid", "release-readiness-command-registry-invalid", "browser-diagnostic-command-registry-invalid", "planning-checkpoint-required", "product-checkpoint-required", "deferred-proof", "release-readiness-not-evaluated"]}
    },
    "deferred_checks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "deferred_proofs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "next_actions": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["inspect", "plan", "apply", "validate", "define-product-requirements", "create-planning-checkpoint", "implement-product", "populate-product-evidence", "run-product-verifier", "validate-product-state", "create-product-checkpoint", "resolve-deferred-proof", "check-release-readiness"]}
    },
    "next_action_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "argv", "caller_inputs"],
      "properties": {
        "action": {"enum": ["create-planning-checkpoint", "create-product-checkpoint", "check-release-readiness", "diagnose-browser-prerequisites"]},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "caller_inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\{[a-z_]+\\}$"}
        },
        "output_schema": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        }
      }
    }
  }
}
