{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://templates.moukaeritai.work/composition/schemas/mcp-interface.schema.json",
  "title": "MCP interface contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "mode", "transports", "operations"],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "nonBlankText": {"type": "string", "minLength": 1},
    "transportKind": {"enum": ["stdio", "streamable-http"]},
    "operationKind": {"enum": ["tool", "resource", "prompt", "protocol-operation"]},
    "plannedTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "purpose"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"$ref": "#/$defs/transportKind"},
        "purpose": {"$ref": "#/$defs/nonBlankText"}
      }
    },
    "plannedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "transportId", "purpose"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"$ref": "#/$defs/operationKind"},
        "transportId": {"$ref": "#/$defs/identifier"},
        "purpose": {"$ref": "#/$defs/nonBlankText"}
      }
    },
    "productTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "protocolProbe", "success", "negative"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"$ref": "#/$defs/transportKind"},
        "protocolProbe": {"$ref": "#/$defs/nonBlankText"},
        "success": {"$ref": "#/$defs/nonBlankText"},
        "negative": {"$ref": "#/$defs/nonBlankText"}
      }
    },
    "productOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "transportId", "success", "negative"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"$ref": "#/$defs/operationKind"},
        "name": {"$ref": "#/$defs/nonBlankText"},
        "transportId": {"$ref": "#/$defs/identifier"},
        "success": {"$ref": "#/$defs/nonBlankText"},
        "negative": {"$ref": "#/$defs/nonBlankText"}
      }
    }
  },
  "properties": {
    "$schema": {"const": "../schemas/mcp-interface.schema.json"},
    "schemaVersion": {"const": 2},
    "mode": {"enum": ["template", "planning", "product"]},
    "protocolRevision": {"const": "2026-07-28"},
    "transports": {"type": "array", "uniqueItems": true},
    "operations": {"type": "array", "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "template"}}, "required": ["mode"]},
      "then": {
        "properties": {"transports": {"maxItems": 0}, "operations": {"maxItems": 0}},
        "not": {"required": ["protocolRevision"]}
      }
    },
    {
      "if": {"properties": {"mode": {"const": "planning"}}, "required": ["mode"]},
      "then": {
        "required": ["protocolRevision"],
        "properties": {
          "transports": {"minItems": 1, "items": {"$ref": "#/$defs/plannedTransport"}},
          "operations": {"minItems": 1, "items": {"$ref": "#/$defs/plannedOperation"}}
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "product"}}, "required": ["mode"]},
      "then": {
        "required": ["protocolRevision"],
        "properties": {
          "transports": {"minItems": 1, "items": {"$ref": "#/$defs/productTransport"}},
          "operations": {"minItems": 1, "items": {"$ref": "#/$defs/productOperation"}}
        }
      }
    }
  ]
}
