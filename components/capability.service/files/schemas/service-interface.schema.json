{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://templates.moukaeritai.work/composition/schemas/service-interface.schema.json",
  "title": "Service interface contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "mode", "operations"],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "nonBlankText": {"type": "string", "minLength": 1},
    "plannedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "purpose": {"$ref": "#/$defs/nonBlankText"}
      }
    },
    "productOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "invocation", "success", "negative"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "invocation": {"$ref": "#/$defs/nonBlankText"},
        "success": {"$ref": "#/$defs/nonBlankText"},
        "negative": {"$ref": "#/$defs/nonBlankText"}
      }
    }
  },
  "properties": {
    "$schema": {"const": "../schemas/service-interface.schema.json"},
    "schemaVersion": {"const": 2},
    "mode": {"enum": ["template", "planning", "product"]},
    "protocol": {"$ref": "#/$defs/nonBlankText"},
    "operations": {"type": "array", "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "template"}}, "required": ["mode"]},
      "then": {
        "properties": {"operations": {"maxItems": 0}},
        "not": {"required": ["protocol"]}
      }
    },
    {
      "if": {"properties": {"mode": {"const": "planning"}}, "required": ["mode"]},
      "then": {
        "required": ["protocol"],
        "properties": {"operations": {"minItems": 1, "items": {"$ref": "#/$defs/plannedOperation"}}}
      }
    },
    {
      "if": {"properties": {"mode": {"const": "product"}}, "required": ["mode"]},
      "then": {
        "required": ["protocol"],
        "properties": {"operations": {"minItems": 1, "items": {"$ref": "#/$defs/productOperation"}}}
      }
    }
  ]
}
