{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic browser proof prerequisite diagnostics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "browser_binary",
    "webdriver",
    "compatibility",
    "localhost",
    "missing_or_blocked_prerequisites",
    "release_impact"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["available", "unavailable", "not-checked"]},
    "browser_binary": {"enum": ["available", "unavailable", "not-checked"]},
    "webdriver": {"enum": ["available", "unavailable", "not-checked"]},
    "compatibility": {"enum": ["compatible", "incompatible", "not-checked"]},
    "localhost": {"enum": ["allowed", "restricted", "not-checked"]},
    "missing_or_blocked_prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "browser-binary-unavailable",
          "webdriver-unavailable",
          "incompatible-browser-driver",
          "localhost-browser-sandbox-restricted"
        ]
      }
    },
    "release_impact": {"enum": ["none", "not-ready", "not-evaluated"]}
  }
}
