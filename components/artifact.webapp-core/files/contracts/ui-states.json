{
  "$schema": "../schemas/ui-states.schema.json",
  "schemaVersion": 2,
  "states": [
    {
      "id": "loading",
      "scope": "route",
      "category": "progress",
      "description": "Required data or code is still being acquired.",
      "recoveryActions": [],
      "announcement": "polite",
      "focusStrategy": "preserve"
    },
    {
      "id": "empty",
      "scope": "route",
      "category": "content",
      "description": "The request succeeded but no user-visible content is available yet.",
      "recoveryActions": [],
      "announcement": "polite",
      "focusStrategy": "main-heading"
    },
    {
      "id": "populated",
      "scope": "route",
      "category": "content",
      "description": "The requested content is complete and available.",
      "recoveryActions": [],
      "announcement": "none",
      "focusStrategy": "preserve"
    },
    {
      "id": "recoverable-error",
      "scope": "route",
      "category": "error",
      "description": "The operation failed and can be retried without leaving the workflow.",
      "recoveryActions": ["retry"],
      "announcement": "assertive",
      "focusStrategy": "error-summary"
    },
    {
      "id": "offline",
      "scope": "route",
      "category": "connectivity",
      "description": "A required network operation is unavailable because connectivity is absent.",
      "recoveryActions": ["retry-when-online"],
      "announcement": "polite",
      "focusStrategy": "preserve"
    }
  ]
}
