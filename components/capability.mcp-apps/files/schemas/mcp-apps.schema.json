{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://templates.moukaeritai.work/composition/schemas/mcp-apps.schema.json",
  "title": "MCP Apps extension contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "mode",
    "views",
    "associations"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/mcp-apps.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "enum": [
        "template",
        "product"
      ]
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "identifier",
        "revision",
        "success",
        "negative"
      ],
      "properties": {
        "id": {
          "const": "mcp-apps"
        },
        "identifier": {
          "const": "io.modelcontextprotocol/ui"
        },
        "revision": {
          "const": "2026-01-26"
        },
        "success": {
          "type": "string",
          "minLength": 1
        },
        "negative": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "resourceUri",
          "mediaType",
          "success",
          "negative"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "resourceUri": {
            "type": "string",
            "pattern": "^ui://[^\\s]+$"
          },
          "mediaType": {
            "const": "text/html;profile=mcp-app"
          },
          "success": {
            "type": "string",
            "minLength": 1
          },
          "negative": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "associations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operationId",
          "viewId",
          "success",
          "negative"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "operationId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "viewId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "success": {
            "type": "string",
            "minLength": 1
          },
          "negative": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "template"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "views": {
            "maxItems": 0
          },
          "associations": {
            "maxItems": 0
          }
        },
        "not": {
          "required": [
            "extension"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "product"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "extension"
        ],
        "properties": {
          "views": {
            "minItems": 1
          },
          "associations": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
