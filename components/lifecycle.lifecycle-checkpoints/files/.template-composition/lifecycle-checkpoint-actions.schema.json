{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lifecycle checkpoint action registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "actions"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": 1},
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create-planning-checkpoint", "create-product-checkpoint"],
      "properties": {
        "create-planning-checkpoint": {"$ref": "#/$defs/action"},
        "create-product-checkpoint": {"$ref": "#/$defs/action"}
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "caller_inputs", "bindings"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "caller_inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\{[a-z_]+\\}$"}
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {"enum": ["latest-checkpoint-id"]},
          "propertyNames": {"pattern": "^\\{[a-z_]+\\}$"}
        }
      }
    }
  }
}
