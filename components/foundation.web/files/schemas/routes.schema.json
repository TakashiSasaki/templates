{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "routes"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
    },
    "routePath": {
      "type": "string",
      "pattern": "^/(?!\\.{1,2}(?:/|$))(?:[A-Za-z0-9._~-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._~-]+)*)?(?![\\s\\S])"
    },
    "nonBlankText": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u034F\\u061C\\u115F\\u1160\\u1680\\u17B4\\u17B5\\u180B-\\u180F\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u206F\\u2800\\u3000\\u3164\\uFE00-\\uFE0F\\uFEFF\\uFFA0\\uFFF0-\\uFFFF𓑁𓑂𝅙]"
    }
  },
  "properties": {
    "$schema": {
      "const": "../schemas/routes.schema.json"
    },
    "schemaVersion": {
      "const": 4
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "canonical",
          "aliases",
          "deepLink",
          "accessibility"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "path": {
            "$ref": "#/$defs/routePath"
          },
          "canonical": {
            "const": true
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/routePath"
            }
          },
          "deepLink": {
            "type": "boolean"
          },
          "accessibility": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "documentTitleRequired",
              "focusTarget"
            ],
            "properties": {
              "documentTitleRequired": {
                "const": true
              },
              "focusTarget": {
                "$ref": "#/$defs/nonBlankText"
              }
            }
          }
        }
      }
    }
  }
}
