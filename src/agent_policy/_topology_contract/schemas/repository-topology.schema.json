{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://templates.moukaeritai.work/schemas/repository-topology.schema.json",
  "title": "Repository topology contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "topologyKind",
    "hub",
    "submoduleProjection",
    "synchronization",
    "components"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "topologyKind": {
      "const": "hub-and-orphan"
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "role", "directMutationForbidden"],
      "properties": {
        "branch": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)\\.[gG][iI][tT](?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "role": {
          "const": "discovery-projection"
        },
        "directMutationForbidden": {
          "const": true
        }
      }
    },
    "submoduleProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selfReferencing", "mountRule"],
      "properties": {
        "selfReferencing": {
          "const": true
        },
        "mountRule": {
          "const": "branch-name-equals-mount-path"
        }
      }
    },
    "synchronization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "authorityMustAdvanceBeforeProjection"],
      "properties": {
        "direction": {
          "const": "authority-to-hub"
        },
        "authorityMustAdvanceBeforeProjection": {
          "const": true
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "branch", "mountPath", "role"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "branch": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)\\.[gG][iI][tT](?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "mountPath": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)\\.[gG][iI][tT](?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "role": {
            "const": "component-authority"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    }
  }
}
