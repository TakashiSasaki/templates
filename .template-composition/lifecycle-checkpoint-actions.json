{
  "$schema": "./lifecycle-checkpoint-actions.schema.json",
  "schemaVersion": 1,
  "actions": {
    "create-planning-checkpoint": {
      "argv": [
        "{python}",
        ".template-composition/run_action.py",
        "create-planning-checkpoint",
        "{checkpoint_id}"
      ],
      "caller_inputs": [
        "{python}",
        "{checkpoint_id}"
      ],
      "bindings": {}
    },
    "create-product-checkpoint": {
      "argv": [
        "{python}",
        ".template-composition/run_action.py",
        "create-product-checkpoint",
        "{checkpoint_id}",
        "{latest_checkpoint_id}"
      ],
      "caller_inputs": [
        "{python}",
        "{checkpoint_id}"
      ],
      "bindings": {
        "{latest_checkpoint_id}": "latest-checkpoint-id"
      }
    }
  }
}
