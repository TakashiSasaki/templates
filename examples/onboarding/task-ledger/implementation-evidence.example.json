{
  "$schema": "../schemas/implementation-evidence.schema.json",
  "schemaVersion": 6,
  "mode": "product",
  "commands": [
    {
      "id": "verify-product",
      "command": "./scripts/verify.sh",
      "purpose": "Run the consumer-owned Task Ledger unit, API, CLI, and browser checks.",
      "execution": {
        "capabilities": [
          "unit",
          "integration",
          "end-to-end",
          "browser",
          "accessibility"
        ],
        "harness": {
          "kind": "repository-file",
          "locator": "scripts/verify.sh"
        },
        "supportsNegativePath": true
      }
    }
  ],
  "releaseGates": [
    {
      "id": "product-verification",
      "purpose": "Require the authoritative Task Ledger product verifier.",
      "commandIds": ["verify-product"]
    }
  ],
  "requirements": [
    {
      "id": "REQ-TASK-LEDGER-BROWSER-FILTER",
      "description": "Task Ledger browser UI filters the visible task list by status.",
      "recordIds": ["routes-route-home"],
      "requiredPositiveProofKinds": ["end-to-end-test", "accessibility-test"]
    }
  ],
  "records": [
    {
      "id": "routes-route-home",
      "target": {
        "kind": "contract-item",
        "contractId": "routes",
        "itemKind": "route",
        "itemId": "home"
      },
      "implementationBoundary": {
        "status": "verified",
        "description": "The Task Ledger primary page and status filter are implemented.",
        "locator": "task_ledger/static/index.html"
      },
      "positiveEvidence": [
        {
          "id": "task-ledger-browser-filter-positive",
          "status": "verified",
          "kind": "end-to-end-test",
          "description": "A real browser changes the status filter and shows only matching tasks.",
          "locator": "tests/test_task_ledger_browser.py",
          "commandId": "verify-product",
          "expectedResult": "The selected status is reflected in the visible task list."
        }
      ],
      "negativeEvidence": [
        {
          "id": "task-ledger-browser-filter-negative",
          "status": "verified",
          "kind": "accessibility-test",
          "description": "A real browser rejects an unsupported filter value.",
          "locator": "tests/test_task_ledger_browser.py",
          "commandId": "verify-product",
          "expectedResult": "Invalid filter input is rejected and does not produce a false success."
        }
      ],
      "releaseGateIds": ["product-verification"]
    }
  ]
}