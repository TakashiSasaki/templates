{
  "$schema": "https://templates.moukaeritai.work/schemas/agent-bootstrap.schema.json",
  "schema_version": 6,
  "repository": "TakashiSasaki/templates",
  "canonical_url": "https://templates.moukaeritai.work/agent.json",
  "purpose": "Discover independent authorities and exact publication provenance",
  "integration_source": {
    "lock": "integration-source.json"
  },
  "authorities": {
    "composition": {
      "role": "artifact-foundation-capability-lifecycle-topology-semantics",
      "canonical_entry": "https://templates.moukaeritai.work/composition/"
    },
    "policy": {
      "role": "coding-agent-operating-policy",
      "canonical_entry": "https://templates.moukaeritai.work/policy/",
      "relationship_to_composition": "independent-optional"
    },
    "integration": {
      "role": "cross-authority-publication-integration",
      "contract": "Integrated Publication Bundle v3",
      "provider_selection_owner": true
    },
    "site": {
      "role": "presentation-runtime-deployment",
      "consumer_repository_mutation": false,
      "provider_selection_owner": false
    }
  },
  "integration_contracts": {
    "authority_model": {
      "owner": "integration",
      "canonical_repository_path": "authority.json",
      "human_projection": "https://templates.moukaeritai.work/maintain/site/authority-model/"
    },
    "publication_bundle": {
      "owner": "integration",
      "canonical_repository_path": "contracts/publication-bundle/README.md"
    }
  },
  "dependency_direction": [
    [
      "composition",
      "integration"
    ],
    [
      "policy",
      "integration"
    ],
    [
      "integration",
      "site"
    ],
    [
      "site",
      "github-pages"
    ]
  ]
}
