  "schema_version": 5,
  "repository": "TakashiSasaki/templates",
  "canonical_url": "https://templates.moukaeritai.work/agent.json",
  "purpose": "Discover authorities and compose new or existing software repositories",
  "authorities": {
    "composition": {
      "role": "artifact-capability-lifecycle-semantics",
      "publication_revision": "31f2aeafdfe68ad9b43b930767634a1885172195",
      "overview_document_id": "composition:overview",
      "publication_catalog_path": "docs/publication-catalog.json"
    },
    "policy": {
      "role": "coding-agent-operating-policy",
      "publication_revision": "c5a3294809a1066bf59b83f467f1d597f885289a",
      "overview_document_id": "policy:overview",
      "publication_catalog_path": "docs/publication-catalog.json",
      "relationship_to_composition": "independent-optional"
    },
    "site": {
      "role": "publication-integration",
      "overview_document_id": "site:portal-home",
      "consumer_repository_mutation": false
    }
  },
  "task_routing": {
    "composition": {
      "required_when": [
        "select-or-materialize-artifact-structure",
        "select-capabilities-or-lifecycle"
      ]
    },
    "policy": {
      "required_when": [
        "task-explicitly-requires-coding-agent-operating-policy",
        "repository-needs-coding-agent-operating-rules"
      ]
    },
    "combined": {
      "required_when": "both-provider-conditions-apply",
      "authority_order": [
        "composition",
        "policy"
      ],
      "providers_remain_independent": true
    }
  },
  "integration_contracts": {
    "authority_model": {
      "owner": "site",
      "repository_path": "docs/authority-model.md"
    },
    "policy_composition_coexistence": {
      "owner": "site",
      "document_id": "site:policy-composition-coexistence",
      "canonical_url": "https://templates.moukaeritai.work/coexistence/"
    }
  },
  "composition": {
    "publication_revision": "31f2aeafdfe68ad9b43b930767634a1885172195",
    "installer": {
      "repository": "TakashiSasaki/templates",
      "revision": "60bb93751f0163d7c523a06a32c2fefb562ee7e3",
      "path": "scripts/install_composition_skill.py",
      "sha256": "e79e43785f92bbc049619360e0680873504b0f33db1670010d85750786d24b93",
      "url": "https://raw.githubusercontent.com/TakashiSasaki/templates/60bb93751f0163d7c523a06a32c2fefb562ee7e3/scripts/install_composition_skill.py"
    },
    "skill": {
      "name": "composition",
      "repository": "TakashiSasaki/templates",
      "revision": "3e1c093a173c406e9fea2ea761e1aa1f0cf32038",
      "path": "skills/composition",
      "entrypoint": "scripts/run.py",
      "instructions_url": "https://raw.githubusercontent.com/TakashiSasaki/templates/3e1c093a173c406e9fea2ea761e1aa1f0cf32038/skills/composition/SKILL.md"
    },
    "toolchain": {
      "repository": "TakashiSasaki/templates",
      "revision": "b4581b58301b1f2736fce86dfcd56d7ddb98bff0"
    }
  },
  "policy": {
    "publication_revision": "c5a3294809a1066bf59b83f467f1d597f885289a",
    "installer": {
      "repository": "TakashiSasaki/templates",
      "revision": "f4457c90854db34c3ce8e1c381f67a4d7d5ea523",
      "path": "scripts/install_agent_policy_skill.py",
      "url": "https://raw.githubusercontent.com/TakashiSasaki/templates/f4457c90854db34c3ce8e1c381f67a4d7d5ea523/scripts/install_agent_policy_skill.py"
    },
    "skill": {
      "name": "agent-policy",
      "repository": "TakashiSasaki/templates",
      "revision": "344aaf0b140e3c066363297012bb866efbc106e4",
      "path": "skills/agent-policy",
      "unmanaged_entrypoint": "scripts/bootstrap.py",
      "managed_entrypoint": "scripts/run.py",
      "instructions_url": "https://raw.githubusercontent.com/TakashiSasaki/templates/344aaf0b140e3c066363297012bb866efbc106e4/skills/agent-policy/SKILL.md"
    }
  },
  "requirements": {
    "python": {
      "minimum": "3.11",
      "maximum": "3.14"
    },
    "https": true,
    "policy": {
      "git": true
    }
  },
  "composition_bootstrap": {
    "download": "https",
    "verify": "sha256-before-execute",
    "execute": "python-isolated",
    "installation_modes": [
      "persistent",
      "transient"
    ],
    "canonical_operation": "execute-verified-installer-argv",
    "reimplementation_policy": "do-not-reimplement",
    "verified_installer_argv": [
      "{python}",
      "-I",
      "-c",
      "import hashlib\nimport pathlib\nimport subprocess\nimport sys\nimport urllib.request\n\nurl, expected, installer_file, skill_target = sys.argv[1:5]\ndata = urllib.request.urlopen(url, timeout=30).read()\nactual = hashlib.sha256(data).hexdigest()\nif actual != expected:\n    raise SystemExit(\n        f\"installer SHA-256 mismatch: expected {expected}, got {actual}\"\n    )\npath = pathlib.Path(installer_file)\npath.parent.mkdir(parents=True, exist_ok=True)\npath.write_bytes(data)\nsubprocess.run(\n    [sys.executable, \"-I\", str(path), skill_target],\n    check=True,\n)\n",
      "{installer_url}",
      "{installer_sha256}",
      "{installer_file}",
      "{skill_target}"
    ],
    "argument_bindings": {
      "{installer_url}": "composition.installer.url",
      "{installer_sha256}": "composition.installer.sha256"
    },
    "caller_inputs": [
      "{python}",
      "{installer_file}",
      "{skill_target}"
    ]
  },
  "policy_bootstrap": {
    "download": "https",
    "verify": "immutable-full-sha-url",
    "execute": "python-isolated",
    "canonical_operation": "execute-immutable-installer-argv",
    "reimplementation_policy": "do-not-reimplement",
    "immutable_installer_argv": [
      "{python}",
      "-I",
      "-c",
      "import sys\nimport urllib.request\n\nurl, skill_target = sys.argv[1:3]\ndata = urllib.request.urlopen(url, timeout=30).read()\nif not data:\n    raise SystemExit(\"Policy installer download was empty\")\nsys.argv = [url, skill_target]\nexec(compile(data, url, \"exec\"))\n",
      "{installer_url}",
      "{skill_target}"
    ],
    "argument_bindings": {
      "{installer_url}": "policy.installer.url"
    },
    "caller_inputs": [
      "{python}",
      "{skill_target}"
    ]
  },
  "composition_workflow": {
    "runner_argv": [
      "{python}",
      "{skill_target}/scripts/run.py",
      "--repository",
      "{repository}",
      "{command}"
    ],
    "diagnose": "doctor",
    "provenance": "provenance",
    "inspect_before_mutation": "inspect",
    "plan_before_apply": true,
    "validate_after_apply": true
  },
  "policy_workflow": {
    "unmanaged_inspect_argv": [
      "{python}",
      "{skill_target}/scripts/bootstrap.py",
      "--repository",
      "{repository}"
    ],
    "unmanaged_apply_argv": [
      "{python}",
      "{skill_target}/scripts/bootstrap.py",
      "--repository",
      "{repository}",
      "--apply"
    ],
    "unmanaged_apply_with_primary_instructions_argv": [
      "{python}",
      "{skill_target}/scripts/bootstrap.py",
      "--repository",
      "{repository}",
      "--primary-instructions",
      "{primary_instructions}",
      "--apply"
    ],
    "primary_instructions_selection_source": "unmanaged-inspect-output",
    "unmanaged_apply_outcomes": {
      "fresh": "managed-and-validated",
      "migration": "prepared-and-previewed-finalization-pending"
    },
    "migration_finalization": {
      "automatic": false,
      "requires_separate_explicit_instruction": true,
      "finalize_argv": [
        "{python}",
        "{skill_target}/scripts/run.py",
        "--repository",
        "{repository}",
        "adopt",
        "finalize",
        "--apply"
      ],
      "post_finalize_verification_commands": [
        "validate",
        "check"
      ]
    },
    "managed_runner_argv": [
      "{python}",
      "{skill_target}/scripts/run.py",
      "--repository",
      "{repository}",
      "{command}"
    ],
    "inspect_before_mutation": true,
    "apply_requires_reviewed_dry_run": true,
    "managed_verification_commands": [
      "render",
      "validate",
      "check"
    ]
  }
}
