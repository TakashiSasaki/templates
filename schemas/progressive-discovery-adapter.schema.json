{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "inventories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/inventory"
      }
    },
    "projections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/projection"
      }
    },
    "exclude": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reason"
      }
    },
    "delegate": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/delegation"
      }
    },
    "omit_from": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/omission"
      }
    },
    "generated": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/generated"
      }
    },
    "retire": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reason"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TakashiSasaki/templates/schemas/progressive-discovery-adapter.schema.json",
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\?#%\\s:])(?!.*//)(?!.* /)[^/]+(?:/[^/]+)*$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "kind": {
          "enum": [
            "file",
            "directory",
            "index"
          ]
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "namespace",
        "kind"
      ],
      "properties": {
        "at": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "namespace": {
          "enum": [
            "local",
            "external",
            "deployment"
          ]
        },
        "kind": {
          "enum": [
            "file",
            "directory",
            "index"
          ]
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format",
        "select"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "format": {
          "enum": [
            "json",
            "yaml"
          ]
        },
        "select": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/selector"
          }
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sources"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "reason": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "entry",
        "reason"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "entry": {
          "$ref": "#/$defs/entry"
        },
        "reason": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "paths",
        "reason"
      ],
      "properties": {
        "index": {
          "$ref": "#/$defs/path"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "reason": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "title",
        "section",
        "members"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "section": {
          "type": "string",
          "pattern": "\\S"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    }
  }
}
