{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://templates.moukaeritai.work/schemas/composition/composition-playground-projection.schema.json",
  "title": "Composition Playground v1 canonical projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_id",
    "source",
    "scope",
    "recipes",
    "components",
    "contracts",
    "materials",
    "cases"
  ],
  "$defs": {
    "componentId": {
      "type": "string",
      "pattern": "^(foundation|artifact|capability|lifecycle)\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "recipe", "components", "parameters"],
      "properties": {
        "schema_version": {"const": 1},
        "recipe": {"type": "string", "minLength": 1},
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include", "exclude"],
          "properties": {
            "include": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
            "exclude": {"const": []}
          }
        },
        "parameters": {"const": {}}
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["recipe-artifact", "recipe-required", "recipe-default", "explicit-include", "dependency"]
        },
        "from_component": {"$ref": "#/$defs/componentId"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "dependency"}}, "required": ["kind"]},
          "then": {"required": ["from_component"]},
          "else": {"not": {"required": ["from_component"]}}
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "projection_id": {"const": "composition-playground-v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "authority", "revision"],
      "properties": {
        "repository": {"const": "TakashiSasaki/templates"},
        "authority": {"const": "composition"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "target", "components_exclude", "parameters"],
      "properties": {
        "mode": {"const": "initial"},
        "target": {"const": "empty"},
        "components_exclude": {"const": []},
        "parameters": {"const": {}}
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "artifact", "required_components", "default_components", "optional_components", "case_count", "source_path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "artifact": {"$ref": "#/$defs/componentId"},
          "required_components": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
          "default_components": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
          "optional_components": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
          "case_count": {"type": "integer", "minimum": 1},
          "source_path": {"$ref": "#/$defs/relativePath"}
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "version", "summary", "requires", "conflicts", "contract_ids", "material_declarations", "source_path"],
        "properties": {
          "id": {"$ref": "#/$defs/componentId"},
          "role": {"enum": ["foundation", "artifact", "capability", "lifecycle"]},
          "version": {"type": "integer", "minimum": 1},
          "summary": {"type": "string", "minLength": 1},
          "requires": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
          "conflicts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
          "contract_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
          "material_declarations": {"type": "array", "items": {"type": "object"}},
          "source_path": {"$ref": "#/$defs/relativePath"}
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "component", "id", "document", "schema", "document_schema_version", "purpose"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "component": {"$ref": "#/$defs/componentId"},
          "id": {"type": "string", "minLength": 1},
          "document": {"$ref": "#/$defs/relativePath"},
          "schema": {"$ref": "#/$defs/relativePath"},
          "document_schema_version": {"type": "integer", "minimum": 1},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "component", "destination", "ownership", "sha256"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "component": {"$ref": "#/$defs/componentId"},
          "destination": {"$ref": "#/$defs/relativePath"},
          "ownership": {"enum": ["managed", "generated", "seed"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "recipe", "include_mask", "explicit_includes", "configuration", "valid", "error", "resolved_components", "selection_provenance", "contract_ids", "material_ids", "initial_plan"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[0-9a-f]+$"},
          "recipe": {"type": "string", "minLength": 1},
          "include_mask": {"type": "integer", "minimum": 0},
          "explicit_includes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
          "configuration": {"$ref": "#/$defs/configuration"},
          "valid": {"type": "boolean"},
          "error": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "message"],
                "properties": {
                  "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
                  "message": {"type": "string", "minLength": 1}
                }
              }
            ]
          },
          "resolved_components": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
          "selection_provenance": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["component", "reasons"],
              "properties": {
                "component": {"$ref": "#/$defs/componentId"},
                "reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reason"}}
              }
            }
          },
          "contract_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
          "material_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
          "initial_plan": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["action_counts", "conflict_count"],
                "properties": {
                  "action_counts": {
                    "type": "object",
                    "additionalProperties": {"type": "integer", "minimum": 0}
                  },
                  "conflict_count": {"const": 0}
                }
              }
            ]
          }
        }
      }
    }
  }
}
