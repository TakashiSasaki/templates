{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://templates.moukaeritai.work/schemas/composition/composition-playground-projection.schema.json",
  "title": "Composition Playground v1 canonical projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_id",
    "source",
    "scope",
    "provenance_reason_bits",
    "recipes",
    "components",
    "contracts",
    "materials",
    "outcomes"
  ],
  "$defs": {
    "componentId": {
      "type": "string",
      "pattern": "^(foundation|artifact|capability|lifecycle)\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "error", "outcome_id", "selection_reason_masks"],
      "properties": {
        "valid": {"type": "boolean"},
        "error": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
                "message": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        "outcome_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 0}
          ]
        },
        "selection_reason_masks": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1, "maximum": 31}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"valid": {"const": true}}, "required": ["valid"]},
          "then": {
            "properties": {
              "error": {"type": "null"},
              "outcome_id": {"type": "integer", "minimum": 0},
              "selection_reason_masks": {"minItems": 1}
            }
          },
          "else": {
            "properties": {
              "error": {"type": "object"},
              "outcome_id": {"type": "null"},
              "selection_reason_masks": {"const": []}
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "projection_id": {"const": "composition-playground-v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "authority", "revision"],
      "properties": {
        "repository": {"const": "TakashiSasaki/templates"},
        "authority": {"const": "composition"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "target", "configuration_schema_version", "components_exclude", "parameters"],
      "properties": {
        "mode": {"const": "initial"},
        "target": {"const": "empty"},
        "configuration_schema_version": {"const": 1},
        "components_exclude": {"const": []},
        "parameters": {"const": {}}
      }
    },
    "provenance_reason_bits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe_artifact", "recipe_required", "recipe_default", "explicit_include", "dependency"],
      "properties": {
        "recipe_artifact": {"const": 1},
        "recipe_required": {"const": 2},
        "recipe_default": {"const": 4},
        "explicit_include": {"const": 8},
        "dependency": {"const": 16}
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "artifact", "required_components", "default_components", "optional_components", "case_count", "source_path", "cases"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "artifact": {"$ref": "#/$defs/componentId"},
          "required_components": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
          "default_components": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
          "optional_components": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
          "case_count": {"type": "integer", "minimum": 1},
          "source_path": {"$ref": "#/$defs/relativePath"},
          "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "version", "summary", "requires", "conflicts", "contract_ids", "material_declarations", "source_path"],
        "properties": {
          "id": {"$ref": "#/$defs/componentId"},
          "role": {"enum": ["foundation", "artifact", "capability", "lifecycle"]},
          "version": {"type": "integer", "minimum": 1},
          "summary": {"type": "string", "minLength": 1},
          "requires": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
          "conflicts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
          "contract_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
          "material_declarations": {"type": "array", "items": {"type": "object"}},
          "source_path": {"$ref": "#/$defs/relativePath"}
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "component", "id", "document", "schema", "document_schema_version", "purpose"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "component": {"$ref": "#/$defs/componentId"},
          "id": {"type": "string", "minLength": 1},
          "document": {"$ref": "#/$defs/relativePath"},
          "schema": {"$ref": "#/$defs/relativePath"},
          "document_schema_version": {"type": "integer", "minimum": 1},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "component", "destination", "ownership", "sha256"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "component": {"$ref": "#/$defs/componentId"},
          "destination": {"$ref": "#/$defs/relativePath"},
          "ownership": {"enum": ["managed", "generated", "seed"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "resolved_components", "dependency_edges", "contract_ids", "material_ids", "initial_plan"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "resolved_components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
          "dependency_edges": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "array",
              "prefixItems": [
                {"type": "integer", "minimum": 0},
                {"type": "integer", "minimum": 0}
              ],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "contract_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
          "material_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
          "initial_plan": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action_counts", "conflict_count"],
            "properties": {
              "action_counts": {
                "type": "object",
                "additionalProperties": {"type": "integer", "minimum": 0}
              },
              "conflict_count": {"const": 0}
            }
          }
        }
      }
    }
  }
}
