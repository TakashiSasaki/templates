{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://templates.moukaeritai.work/schemas/composition/composition-playground-intent.schema.json",
  "title": "Composition Playground explicit-intent sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projection_id", "source", "resolution_projection_id", "strategy", "encoding", "errors", "recipes"],
  "$defs": {
    "componentId": {"type": "string", "pattern": "^(foundation|artifact|capability|lifecycle)\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "message": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "projection_id": {"const": "composition-playground-intent-v1"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "authority", "revision"],
      "properties": {"repository": {"const": "TakashiSasaki/templates"}, "authority": {"const": "composition"}, "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
    },
    "resolution_projection_id": {"const": "composition-playground-v1"},
    "strategy": {"const": "indexed-single-explicit-exclusion-transitions"},
    "encoding": {
      "type": "object", "additionalProperties": false,
      "required": ["nonnegative", "negative"],
      "properties": {
        "nonnegative": {"const": "canonical outcome id"},
        "negative": {"const": "-(error index + 1)"}
      }
    },
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
    "recipes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "optional_components", "case_count", "cases"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "optional_components": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
          "case_count": {"type": "integer", "minimum": 1},
          "cases": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "array",
              "items": {"type": "integer"}
            }
          }
        }
      }
    }
  }
}
