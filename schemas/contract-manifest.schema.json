{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contracts"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"
    },
    "documentPath": {
      "type": "string",
      "pattern": "^contracts/[a-z][a-z0-9-]*\\.json(?![\\s\\S])"
    },
    "schemaPath": {
      "type": "string",
      "pattern": "^schemas/[a-z][a-z0-9-]*\\.schema\\.json(?![\\s\\S])"
    },
    "nonBlankText": {
      "type": "string",
      "minLength": 1
    }
  },
  "properties": {
    "$schema": {
      "const": "../schemas/contract-manifest.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "document",
          "schema",
          "documentSchemaVersion",
          "purpose"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "document": {
            "$ref": "#/$defs/documentPath"
          },
          "schema": {
            "$ref": "#/$defs/schemaPath"
          },
          "documentSchemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "purpose": {
            "$ref": "#/$defs/nonBlankText"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "surfaces"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "routes"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "ui_states"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "viewports"
              }
            }
          }
        }
      ]
    }
  }
}
