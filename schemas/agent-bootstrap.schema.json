{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://templates.moukaeritai.work/schemas/agent-bootstrap.schema.json",
  "title": "Four-authority discovery projection v6",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "authorities",
    "integration_source",
    "integration_contracts",
    "dependency_direction"
  ],
  "properties": {
    "schema_version": {
      "const": 6
    },
    "repository": {
      "const": "TakashiSasaki/templates"
    },
    "authorities": {
      "type": "object",
      "required": [
        "composition",
        "policy",
        "integration",
        "site"
      ],
      "additionalProperties": false,
      "properties": {
        "composition": {
          "type": "object",
          "required": [
            "role"
          ],
          "properties": {
            "role": {
              "const": "artifact-foundation-capability-lifecycle-topology-semantics"
            }
          }
        },
        "policy": {
          "type": "object",
          "required": [
            "role"
          ],
          "properties": {
            "role": {
              "const": "coding-agent-operating-policy"
            }
          }
        },
        "integration": {
          "type": "object",
          "required": [
            "role"
          ],
          "properties": {
            "role": {
              "const": "cross-authority-publication-integration"
            }
          }
        },
        "site": {
          "type": "object",
          "required": [
            "role"
          ],
          "properties": {
            "role": {
              "const": "presentation-runtime-deployment"
            }
          }
        }
      }
    },
    "integration_source": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "lock"
          ],
          "additionalProperties": false,
          "properties": {
            "lock": {
              "const": "integration-source.json"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "schema_version",
            "identity",
            "content_digest",
            "producer",
            "providers"
          ],
          "properties": {
            "schema_version": {
              "const": 3
            },
            "identity": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "content_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "producer": {
              "type": "object",
              "required": [
                "authority",
                "revision"
              ],
              "properties": {
                "authority": {
                  "const": "integration"
                },
                "revision": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              }
            },
            "providers": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      ]
    }
  }
}
