{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://templates.moukaeritai.work/schemas/agent-bootstrap.schema.json",
  "title": "TakashiSasaki/templates coding-agent bootstrap manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "repository",
    "canonical_url",
    "purpose",
    "composition",
    "requirements",
    "bootstrap",
    "workflow"
  ],
  "properties": {
    "$schema": {"const": "https://templates.moukaeritai.work/schemas/agent-bootstrap.schema.json"},
    "schema_version": {"const": 2},
    "repository": {"const": "TakashiSasaki/templates"},
    "canonical_url": {"const": "https://templates.moukaeritai.work/agent.json"},
    "purpose": {"const": "Compose new or existing software repositories"},
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_revision", "installer", "skill", "toolchain"],
      "properties": {
        "publication_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "installer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "revision", "path", "sha256", "url"],
          "properties": {
            "repository": {"const": "TakashiSasaki/templates"},
            "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "path": {"const": "scripts/install_composition_skill.py"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "url": {"type": "string", "pattern": "^https://raw\\.githubusercontent\\.com/TakashiSasaki/templates/[0-9a-f]{40}/scripts/install_composition_skill\\.py$"}
          }
        },
        "skill": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "repository", "revision", "path", "entrypoint", "instructions_url"],
          "properties": {
            "name": {"const": "composition"},
            "repository": {"const": "TakashiSasaki/templates"},
            "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "path": {"const": "skills/composition"},
            "entrypoint": {"const": "scripts/run.py"},
            "instructions_url": {"type": "string", "pattern": "^https://raw\\.githubusercontent\\.com/TakashiSasaki/templates/[0-9a-f]{40}/skills/composition/SKILL\\.md$"}
          }
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "revision"],
          "properties": {
            "repository": {"const": "TakashiSasaki/templates"},
            "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "https"],
      "properties": {
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {"const": "3.11"},
            "maximum": {"const": "3.14"}
          }
        },
        "https": {"const": true}
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["download", "verify", "execute", "installation_modes", "canonical_operation", "reimplementation_policy", "verified_installer_argv", "argument_bindings", "caller_inputs"],
      "properties": {
        "download": {"const": "https"},
        "verify": {"const": "sha256-before-execute"},
        "execute": {"const": "python-isolated"},
        "installation_modes": {
          "type": "array",
          "prefixItems": [
            {"const": "persistent"},
            {"const": "transient"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "canonical_operation": {"const": "execute-verified-installer-argv"},
        "reimplementation_policy": {"const": "do-not-reimplement"},
        "verified_installer_argv": {
          "type": "array",
          "prefixItems": [
            {"const": "{python}"},
            {"const": "-I"},
            {"const": "-c"},
            {"type": "string", "minLength": 1},
            {"const": "{installer_url}"},
            {"const": "{installer_sha256}"},
            {"const": "{installer_file}"},
            {"const": "{skill_target}"}
          ],
          "items": false,
          "minItems": 8,
          "maxItems": 8
        },
        "argument_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["{installer_url}", "{installer_sha256}"],
          "properties": {
            "{installer_url}": {"const": "composition.installer.url"},
            "{installer_sha256}": {"const": "composition.installer.sha256"}
          }
        },
        "caller_inputs": {
          "type": "array",
          "prefixItems": [
            {"const": "{python}"},
            {"const": "{installer_file}"},
            {"const": "{skill_target}"}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_argv",
        "diagnose",
        "provenance",
        "inspect_before_mutation",
        "plan_before_apply",
        "validate_after_apply"
      ],
      "properties": {
        "runner_argv": {
          "type": "array",
          "prefixItems": [
            {"const": "{python}"},
            {"const": "{skill_target}/scripts/run.py"},
            {"const": "--repository"},
            {"const": "{repository}"},
            {"const": "{command}"}
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        "diagnose": {"const": "doctor"},
        "provenance": {"const": "provenance"},
        "inspect_before_mutation": {"const": "inspect"},
        "plan_before_apply": {"const": true},
        "validate_after_apply": {"const": true}
      }
    }
  }
}
