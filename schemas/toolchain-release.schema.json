{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://templates.moukaeritai.work/schemas/toolchain-release.schema.json",
  "title": "agent-policy stable toolchain release",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "channel", "toolchain", "contracts", "verifier"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "channel": {
      "const": "stable"
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {
          "const": "TakashiSasaki/templates"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_policy_schema",
        "adoption_state_schema",
        "skill_runtime_manifest",
        "lock"
      ],
      "properties": {
        "agent_policy_schema": {
          "type": "integer",
          "minimum": 1
        },
        "adoption_state_schema": {
          "type": "integer",
          "minimum": 1
        },
        "skill_runtime_manifest": {
          "type": "integer",
          "minimum": 1
        },
        "lock": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements"],
      "properties": {
        "requirements": {
          "const": "release/verifier-requirements.lock"
        }
      }
    }
  }
}
