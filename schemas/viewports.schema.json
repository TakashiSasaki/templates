{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TakashiSasaki/templates/blob/webapp/schemas/viewports.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "viewports", "inputCapabilities", "constraints"],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
    },
    "inputCapability": {
      "enum": ["touch", "pointer", "keyboard", "voice", "switch"]
    }
  },
  "properties": {
    "$schema": {"const": "../schemas/viewports.schema.json"},
    "schemaVersion": {"const": 1},
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "minWidthPx", "description"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "minWidthPx": {"type": "integer", "minimum": 0},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "inputCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/inputCapability"}
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zoomSupported", "horizontalScrolling", "orientationIndependent"],
      "properties": {
        "zoomSupported": {"const": true},
        "horizontalScrolling": {"enum": ["never", "content-specific"]},
        "orientationIndependent": {"type": "boolean"}
      }
    }
  }
}
