{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TakashiSasaki/templates/blob/webapp/schemas/ui-states.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "states"],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
    }
  },
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "description", "recoveryActions", "announcement", "focusStrategy"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "category": {"enum": ["progress", "content", "degraded", "error", "connectivity", "access", "navigation"]},
          "description": {"type": "string", "minLength": 1},
          "recoveryActions": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/identifier"}
          },
          "announcement": {"enum": ["none", "polite", "assertive"]},
          "focusStrategy": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
