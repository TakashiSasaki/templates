{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "states"],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
    },
    "nonBlankText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "properties": {
    "$schema": {"const": "../schemas/ui-states.schema.json"},
    "schemaVersion": {"const": 1},
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "description", "recoveryActions", "announcement", "focusStrategy"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "category": {"enum": ["progress", "content", "degraded", "error", "connectivity", "access", "navigation"]},
          "description": {"$ref": "#/$defs/nonBlankText"},
          "recoveryActions": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/identifier"}
          },
          "announcement": {"enum": ["none", "polite", "assertive"]},
          "focusStrategy": {"$ref": "#/$defs/nonBlankText"}
        }
      }
    }
  }
}
