{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site trusted-review execution adoption record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "site_authority", "source", "adoption_procedure", "runtime_inputs", "adopted_files"],
  "properties": {
    "schema_version": { "const": 2 },
    "kind": { "const": "site-policy-execution-adoption" },
    "site_authority": { "const": "site" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "authority", "revision", "tree", "reviewed_prs"],
      "properties": {
        "repository": { "const": "TakashiSasaki/templates" },
        "authority": { "const": "policy" },
        "revision": { "const": "99bb2f7f68ff4af3e72cd4cd583f6bcc0908ea53" },
        "tree": { "const": "96f85ca44c61de583a658bb41bd9f2b3d2c5549f" },
        "reviewed_prs": { "const": [1090, 1095] }
      }
    },
    "adoption_procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "verifier", "verifier_sha256", "tests", "qualification_workflow"],
      "properties": {
        "id": { "const": "site.trusted-review-source-projection" },
        "version": { "const": 3 },
        "verifier": { "const": "scripts/verify_trusted_review_adoption.py" },
        "verifier_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "tests": { "const": "tests/test_trusted_review_adoption.py" },
        "qualification_workflow": { "const": ".github/workflows/trusted-review-bootstrap.yml" }
      }
    },
    "runtime_inputs": {
      "type": "array",
      "minItems": 38,
      "maxItems": 38,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority", "path", "revision", "tree", "object_type", "object_id", "resolution"],
        "properties": {
          "authority": { "const": "policy" },
          "path": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "object_type": { "enum": ["blob", "tree"] },
          "object_id": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "resolution": { "type": "string", "minLength": 1 }
        }
      }
    },
    "adopted_files": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "source_path", "source_revision", "source_tree", "source_blob", "source_mode", "destination_path"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "minLength": 1 },
          "source_revision": { "const": "99bb2f7f68ff4af3e72cd4cd583f6bcc0908ea53" },
          "source_tree": { "const": "96f85ca44c61de583a658bb41bd9f2b3d2c5549f" },
          "source_blob": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "source_mode": { "const": "100644" },
          "destination_path": { "type": "string", "minLength": 1 },
          "transformation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "source_sha256", "output_sha256"],
            "properties": {
              "id": { "const": "site.trusted-review-add-role-protected-root-env" },
              "version": { "const": 1 },
              "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  }
}
