{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site trusted-review execution adoption record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "site_authority", "source", "adoption_procedure", "runtime_inputs", "adopted_files"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "site-policy-execution-adoption" },
    "site_authority": { "const": "site" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "authority", "revision", "tree", "reviewed_prs"],
      "properties": {
        "repository": { "const": "TakashiSasaki/templates" },
        "authority": { "const": "policy" },
        "revision": { "const": "71fad184a072c9335af793ac1efb7e6332c449b0" },
        "tree": { "const": "78d19c3683d9b4cb2d15deaec021021b3b43014d" },
        "reviewed_prs": { "const": [1067, 1069, 1070, 1072] }
      }
    },
    "adoption_procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "verifier", "verifier_sha256", "tests", "qualification_workflow"],
      "properties": {
        "id": { "const": "site.trusted-review-source-projection" },
        "version": { "const": 1 },
        "verifier": { "const": "scripts/verify_trusted_review_adoption.py" },
        "verifier_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "tests": { "const": "tests/test_trusted_review_adoption.py" },
        "qualification_workflow": { "const": ".github/workflows/trusted-review-bootstrap.yml" }
      }
    },
    "runtime_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority", "path", "revision", "object_type", "object_id", "resolution"],
        "properties": {
          "authority": { "const": "policy" },
          "path": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "object_type": { "enum": ["blob", "tree"] },
          "object_id": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "resolution": { "type": "string", "minLength": 1 }
        }
      }
    },
    "adopted_files": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "source_path", "source_blob", "source_mode", "destination_path"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "minLength": 1 },
          "source_blob": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "source_mode": { "const": "100644" },
          "destination_path": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
