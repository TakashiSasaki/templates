{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://templates.moukaeritai.work/schemas/composition/component.schema.json",
  "title": "Composition component descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "version", "summary", "requires", "conflicts", "materials"],
  "$defs": {
    "componentId": {"type": "string", "pattern": "^(artifact|capability|lifecycle)\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "versionInitial": {
      "type": "object", "additionalProperties": false, "required": ["version", "change_type"],
      "properties": {"version": {"const": 1}, "change_type": {"const": "initial"}}
    },
    "versionTransition": {
      "type": "object", "additionalProperties": false, "required": ["version", "change_type", "migration"],
      "properties": {
        "version": {"type": "integer", "minimum": 2},
        "change_type": {"enum": ["additive", "breaking"]},
        "migration": {"type": "string", "pattern": "^docs/migrations/[a-z][a-z0-9-]*-v[1-9][0-9]*-to-v[1-9][0-9]*\\.md$"}
      }
    },
    "versionHistory": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "prefixItems": [{"$ref": "#/$defs/versionInitial"}], "items": {"$ref": "#/$defs/versionTransition"}
    },
    "contractRegistration": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "document", "schema", "migration_slug", "document_schema_version", "version_history", "purpose"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "document": {"type": "string", "pattern": "^contracts/[a-z][a-z0-9-]*\\.json$"},
        "schema": {"type": "string", "pattern": "^schemas/[a-z][a-z0-9-]*\\.schema\\.json$"},
        "migration_slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "document_schema_version": {"type": "integer", "minimum": 1},
        "version_history": {"$ref": "#/$defs/versionHistory"},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "copiedMaterial": {
      "type": "object", "additionalProperties": false, "required": ["source", "destination", "ownership"],
      "properties": {
        "source": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)\\.[gG][iI][tT](?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]*(?:/[A-Za-z0-9_.][A-Za-z0-9._-]*)*$"},
        "destination": {"type": "string", "pattern": "^(?!\\.template-composition/lock\\.json$)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)\\.[gG][iI][tT](?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]*(?:/[A-Za-z0-9_.][A-Za-z0-9._-]*)*$"},
        "ownership": {"enum": ["managed", "seed"]}
      }
    },
    "generatedMaterial": {
      "type": "object", "additionalProperties": false, "required": ["destination", "ownership", "generator"],
      "properties": {
        "destination": {"type": "string", "pattern": "^(?!\\.template-composition/lock\\.json$)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)\\.[gG][iI][tT](?:/|$))[A-Za-z0-9_.][A-Za-z0-9._-]*(?:/[A-Za-z0-9_.][A-Za-z0-9._-]*)*$"},
        "ownership": {"const": "generated"},
        "generator": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/componentId"},
    "kind": {"enum": ["artifact", "capability", "lifecycle"]},
    "version": {"type": "integer", "minimum": 1},
    "summary": {"type": "string", "minLength": 1},
    "requires": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
    "conflicts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentId"}},
    "contract_registrations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/contractRegistration"}},
    "materials": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/copiedMaterial"}, {"$ref": "#/$defs/generatedMaterial"}]}}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "artifact"}}, "required": ["kind"]}, "then": {"properties": {"id": {"pattern": "^artifact\\."}}}},
    {"if": {"properties": {"kind": {"const": "capability"}}, "required": ["kind"]}, "then": {"properties": {"id": {"pattern": "^capability\\."}}}},
    {"if": {"properties": {"kind": {"const": "lifecycle"}}, "required": ["kind"]}, "then": {"properties": {"id": {"pattern": "^lifecycle\\."}}}}
  ]
}
