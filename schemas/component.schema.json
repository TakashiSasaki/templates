{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://templates.moukaeritai.work/schemas/composition/component.schema.json",
  "title": "Composition component descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "version",
    "summary",
    "requires",
    "conflicts",
    "materials"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(artifact|capability|lifecycle)\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "enum": [
        "artifact",
        "capability",
        "lifecycle"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(artifact|capability|lifecycle)\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(artifact|capability|lifecycle)\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "title": "Copied material",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "destination",
              "ownership"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$"
              },
              "destination": {
                "type": "string",
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$"
              },
              "ownership": {
                "enum": [
                  "managed",
                  "seed"
                ]
              }
            }
          },
          {
            "title": "Generated material",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "destination",
              "ownership"
            ],
            "properties": {
              "destination": {
                "type": "string",
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$"
              },
              "ownership": {
                "const": "generated"
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "artifact"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^artifact\\."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "capability"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^capability\\."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "lifecycle"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^lifecycle\\."
          }
        }
      }
    }
  ]
}
