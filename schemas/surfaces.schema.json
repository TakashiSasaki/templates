{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TakashiSasaki/templates/blob/webapp/schemas/surfaces.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "surfaces"],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
    }
  },
  "properties": {
    "$schema": {"const": "../schemas/surfaces.schema.json"},
    "schemaVersion": {"const": 1},
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "purpose",
          "audiences",
          "authentication",
          "authorization",
          "dataClassifications",
          "stability",
          "startupDependencies",
          "diagnostic"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "title": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "audiences": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/identifier"}
          },
          "authentication": {"enum": ["none", "optional", "required"]},
          "authorization": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "roles"],
            "properties": {
              "mode": {"enum": ["public", "authenticated", "role"]},
              "roles": {
                "type": "array",
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/identifier"}
              }
            }
          },
          "dataClassifications": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/identifier"}
          },
          "stability": {"enum": ["experimental", "stable", "deprecated"]},
          "startupDependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/identifier"}
          },
          "diagnostic": {"type": "boolean"}
        }
      }
    }
  }
}
