{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TakashiSasaki/templates/blob/webapp/schemas/routes.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "routes"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "surface",
          "canonical",
          "aliases",
          "authentication",
          "deepLink",
          "historyBehavior",
          "authenticationReturn",
          "states",
          "accessibility"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "path": {
            "type": "string",
            "pattern": "^/(?!\\.{1,2}(?:/|$))(?:[^/?#\\\\]+(?:/(?!\\.{1,2}(?:/|$))[^/?#\\\\]+)*)?$"
          },
          "surface": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "canonical": {"const": true},
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^/(?!\\.{1,2}(?:/|$))(?:[^/?#\\\\]+(?:/(?!\\.{1,2}(?:/|$))[^/?#\\\\]+)*)?$"
            }
          },
          "authentication": {"enum": ["none", "optional", "required"]},
          "deepLink": {"type": "boolean"},
          "historyBehavior": {"enum": ["push", "replace", "external"]},
          "authenticationReturn": {"enum": ["same-route", "not-applicable"]},
          "states": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
          },
          "accessibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["documentTitleRequired", "focusTarget"],
            "properties": {
              "documentTitleRequired": {"type": "boolean"},
              "focusTarget": {"type": "string", "minLength": 1}
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "authentication": {"const": "required"}
              },
              "required": ["authentication"]
            },
            "then": {
              "properties": {
                "authenticationReturn": {"const": "same-route"}
              }
            }
          }
        ]
      }
    }
  }
}
