{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TakashiSasaki/templates/blob/webapp/schemas/routes.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "routes"],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
    },
    "routePath": {
      "type": "string",
      "pattern": "^/(?!\\.{1,2}(?:/|$))(?:[A-Za-z0-9._~-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._~-]+)*)?(?![\\s\\S])"
    }
  },
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "surface",
          "canonical",
          "aliases",
          "authentication",
          "deepLink",
          "historyBehavior",
          "authenticationReturn",
          "states",
          "accessibility"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "path": {"$ref": "#/$defs/routePath"},
          "surface": {"$ref": "#/$defs/identifier"},
          "canonical": {"const": true},
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/routePath"}
          },
          "authentication": {"enum": ["none", "optional", "required"]},
          "deepLink": {"type": "boolean"},
          "historyBehavior": {"enum": ["push", "replace", "external"]},
          "authenticationReturn": {"enum": ["same-route", "not-applicable"]},
          "states": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/identifier"}
          },
          "accessibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["documentTitleRequired", "focusTarget"],
            "properties": {
              "documentTitleRequired": {"const": true},
              "focusTarget": {"type": "string", "minLength": 1}
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "authentication": {"const": "required"}
              },
              "required": ["authentication"]
            },
            "then": {
              "properties": {
                "authenticationReturn": {"const": "same-route"}
              }
            }
          },
          {
            "if": {
              "properties": {
                "authentication": {"const": "none"}
              },
              "required": ["authentication"]
            },
            "then": {
              "properties": {
                "authenticationReturn": {"const": "not-applicable"}
              }
            }
          }
        ]
      }
    }
  }
}
