{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/TakashiSasaki/templates/blob/policy/schemas/trusted-review-freeze-evidence.schema.json",
    "title": "Authenticated trusted-review OCI freeze evidence",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "provider",
        "object",
        "attestation",
        "target",
        "roles",
        "post_freeze_verification"
    ],
    "properties": {
        "schema_version": {
            "const": 1
        },
        "provider": {
            "const": "github-actions-ghcr"
        },
        "object": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "registry",
                "repository",
                "manifest_digest",
                "media_type"
            ],
            "properties": {
                "registry": {
                    "const": "ghcr.io"
                },
                "repository": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._/-]*$"
                },
                "manifest_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "media_type": {
                    "const": "application/vnd.oci.image.manifest.v1+json"
                }
            }
        },
        "attestation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "digest",
                "issuer",
                "repository_id",
                "owner_id",
                "workflow_ref",
                "workflow_sha",
                "source_sha",
                "run_id",
                "run_attempt",
                "event"
            ],
            "properties": {
                "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "issuer": {
                    "const": "https://token.actions.githubusercontent.com"
                },
                "repository_id": {
                    "const": "1315875002"
                },
                "owner_id": {
                    "const": "556958"
                },
                "workflow_ref": {
                    "const": "TakashiSasaki/templates/.github/workflows/trusted-review-bootstrap.yml@refs/heads/site"
                },
                "workflow_sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                },
                "source_sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                },
                "run_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                },
                "run_attempt": {
                    "type": "integer",
                    "minimum": 1
                },
                "event": {
                    "const": "workflow_dispatch"
                }
            }
        },
        "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "repository_id",
                "repository_name",
                "pull_request_id",
                "pull_request_node_id",
                "pull_request_number",
                "base_sha",
                "base_tree",
                "head_sha",
                "head_tree",
                "observation_sha256"
            ],
            "properties": {
                "repository_id": {
                    "const": "1315875002"
                },
                "repository_name": {
                    "const": "TakashiSasaki/templates"
                },
                "pull_request_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                },
                "pull_request_node_id": {
                    "type": "string",
                    "minLength": 1
                },
                "pull_request_number": {
                    "type": "integer",
                    "minimum": 1
                },
                "base_sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                },
                "base_tree": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                },
                "head_sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                },
                "head_tree": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                },
                "observation_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                }
            }
        },
        "roles": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "role",
                    "path",
                    "inventory_sha256",
                    "identity"
                ],
                "properties": {
                    "role": {
                        "enum": [
                            "bootstrap_run_image",
                            "trusted_base_snapshot",
                            "runtime_image",
                            "review_bundle"
                        ]
                    },
                    "path": {
                        "type": "string",
                        "pattern": "^roles/(bootstrap_run_image|trusted_base_snapshot|runtime_image|review_bundle)$"
                    },
                    "inventory_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                    },
                    "identity": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "installer_repository": {
                                "type": "string",
                                "minLength": 1
                            },
                            "installer_revision": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{40}$"
                            },
                            "installer_path": {
                                "type": "string",
                                "minLength": 1
                            },
                            "installer_blob_sha": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{40}$"
                            },
                            "installer_sha256": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                            },
                            "installation_attestation_sha256": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                            },
                            "base_sha": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{40}$"
                            },
                            "base_tree": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{40}$"
                            },
                            "toolchain_repository": {
                                "type": "string",
                                "minLength": 1
                            },
                            "toolchain_revision": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{40}$"
                            },
                            "lock_sha256": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                            },
                            "runtime_attestation_sha256": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                            },
                            "manifest_sha256": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                            },
                            "procedure_skill_sha256": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                            },
                            "semantic_policy_sha256": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                            }
                        }
                    }
                },
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "role": {
                                    "const": "bootstrap_run_image"
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "path": {
                                    "const": "roles/bootstrap_run_image"
                                },
                                "identity": {
                                    "required": [
                                        "installer_repository",
                                        "installer_revision",
                                        "installer_path",
                                        "installer_blob_sha",
                                        "installer_sha256",
                                        "installation_attestation_sha256"
                                    ]
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "role": {
                                    "const": "trusted_base_snapshot"
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "path": {
                                    "const": "roles/trusted_base_snapshot"
                                },
                                "identity": {
                                    "required": [
                                        "base_sha",
                                        "base_tree"
                                    ]
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "role": {
                                    "const": "runtime_image"
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "path": {
                                    "const": "roles/runtime_image"
                                },
                                "identity": {
                                    "required": [
                                        "toolchain_repository",
                                        "toolchain_revision",
                                        "lock_sha256",
                                        "runtime_attestation_sha256"
                                    ]
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "role": {
                                    "const": "review_bundle"
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "path": {
                                    "const": "roles/review_bundle"
                                },
                                "identity": {
                                    "required": [
                                        "manifest_sha256",
                                        "procedure_skill_sha256",
                                        "semantic_policy_sha256"
                                    ]
                                }
                            }
                        }
                    }
                ]
            }
        },
        "post_freeze_verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "result",
                "before_use",
                "after_use",
                "verifier"
            ],
            "properties": {
                "result": {
                    "const": "PASS"
                },
                "before_use": {
                    "const": "PASS"
                },
                "after_use": {
                    "const": "PASS"
                },
                "verifier": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    }
}
